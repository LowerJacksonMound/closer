#!/bin/sh
# closer: the signer's front door (ui/go.py). Run inside the repo: closer go TASK.md | claims TASK.md | status | stop
# Resolves its own symlink so `ln -s .../closer /usr/local/bin/closer` (QUICKSTART) finds ui/go.py beside the real file.
self="$0"
while [ -L "$self" ]; do
  dir="$(cd "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null || {
  echo "closer: needs Python 3.10 or newer as python3; this machine's python3 is $(python3 --version 2>&1 || echo missing). macOS ships 3.9: install a newer one (brew install python, or python.org) and put it first on PATH." >&2
  exit 1
}
exec python3 "$(dirname "$self")/ui/go.py" "$@"

#!/usr/bin/env python3
"""gc — getting-close standalone CLI. Stdlib only. ZERO model calls.

Points the Layer-0 tools at any repo. The tool tree (this checkout) holds the law:
kernel, pack/live, scanner. Per-repo state lives OUTSIDE the target repo so a
writer working in the repo cannot reach its Worlds or tickets:

    $GETTING_CLOSE_HOME (default ~/.getting-close) / <repo-name>-<hash8> /
        manifest.json          roots to scan (paths absolute); python: the repo's interpreter, if given;
                               pytest_args: the repo's own pytest settings (shell words), if given
        manifests/<id>.json    exact manifest used for each World
        worlds/scan_<id>.json  frozen Worlds (chmod a-w, never rewritten)
        tickets/<ticket>.json  tickets made by `gc ticket`
        LATEST                 world_id of the newest World
        policy.json            signer's numbers (`gc policy`): gets_through_anyway

Every subcommand delegates to the existing bin/ tool; gc adds paths, not policy.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn


def need_python() -> None:
    """Python 3.10+ for gc and for the `python3` the pack checks and plants call from PATH. macOS ships
    3.9 as /usr/bin/python3: on it the checks misreport instead of failing, so refuse up front."""
    if sys.version_info < (3, 10):
        sys.exit(f"gc: needs Python 3.10+; {sys.executable} is {sys.version.split()[0]}. "
                 "Put a newer python3 first on PATH.")
    py = shutil.which("python3")
    if py is None:
        sys.exit("gc: no python3 on PATH; the pack checks call it. Put Python 3.10+ on PATH as python3.")
    if Path(py).resolve() != Path(sys.executable).resolve() and subprocess.run(
            [py, "-c", "import sys; sys.exit(sys.version_info < (3, 10))"]).returncode != 0:
        sys.exit(f"gc: python3 on PATH ({py}) is older than 3.10; the pack checks call it. "
                 "Put a newer python3 first on PATH.")


need_python()

HERE = Path(__file__).resolve().parent.parent
BIN = HERE / "bin"
LIVE = HERE / "pack" / "live"
PROPOSALS = HERE / "proposals"

sys.path.insert(0, str(BIN))
sys.path.insert(0, str(HERE))
import governor  # noqa: E402
import safepath  # noqa: E402
import ledger  # noqa: E402
import verify_ticket  # noqa: E402
import world_v1  # noqa: E402
from scanner.substance import is_python  # noqa: E402


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"gc: {msg}", file=sys.stderr)
    raise SystemExit(code)


def run_tool(name: str, *args: str, env: dict | None = None) -> int:
    return subprocess.run([sys.executable, str(BIN / name), *args], env=env).returncode


EVIDENCE_RE = re.compile(r"^(\S+) evidence: (.*)$")
# T16 (2026-10-19): a check says what it could not bring to a verdict on `<name> unjudged: <what>` lines (C1: a claim
# that could not be set up, imported or finished). They stay in `said`, and cmd_land also records every one in the
# row's `unjudged` list (not capped with `said`), so the row and the signer's page show what was not judged.
UNJUDGED_RE = re.compile(r"^(\S+) unjudged: (.*)$")


def run_check(*args: str, env: dict | None = None) -> tuple[int, list[str], list[dict], list[str]]:
    """A pack check through verify_ticket.py. Its output still reaches the writer at land; the check's own
    lines (not verify_ticket's) are also kept for the ledger row, so "nothing to run" and each finding are
    on record (D1). Returns (exit, said, evidence, unjudged lines)."""
    p = subprocess.run([sys.executable, str(BIN / "verify_ticket.py"), *args], capture_output=True, text=True, env=env)
    # Decision 2 (2026-10-15): a check's `<name> evidence: <json>` lines are sealed for the signer (cmd_land files
    # them under <state>/evidence/) and never reach the writer or the row: a strike must not teach the probe.
    evidence: list[dict] = []
    kept: list[str] = []
    unjudged: list[str] = []
    for ln in (p.stdout + p.stderr).splitlines():
        m = EVIDENCE_RE.match(ln.strip())
        if m:
            try:
                evidence.append(json.loads(m.group(2)))
            except json.JSONDecodeError:
                evidence.append({"raw": m.group(2)[:1000]})
            continue
        if UNJUDGED_RE.match(ln.strip()):
            unjudged.append(ln.strip()[:300])
        kept.append(ln)
    sys.stdout.write("".join(ln + "\n" for ln in kept if not ln.startswith("verify_ticket:")))
    said = [ln.strip()[:300] for ln in kept if ln.strip() and not ln.startswith("verify_ticket:")]
    return p.returncode, said[-40:], evidence, unjudged


PACK_LISTS = ("world", "every_ticket", "named")


def pack_manifest() -> dict | None:
    """pack/live/PACK.json (pack v2+). None = pack v1: a land runs only the ticket's named verify.
    A manifest that does not hold together is fatal: the live pack must never be half-read."""
    mf = LIVE / "PACK.json"
    if not mf.is_file():
        return None
    try:
        m = json.loads(mf.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        die(f"pack/live/PACK.json unreadable: {e}")
    v = m.get("pack_version") if isinstance(m, dict) else None
    if isinstance(v, bool) or not isinstance(v, int) or v < 2:
        die("pack/live/PACK.json: pack_version must be an integer >= 2")
    seen: set[str] = set()
    for key in PACK_LISTS:
        names = m.get(key)
        if not isinstance(names, list) or not all(isinstance(n, str) and ID_RE.fullmatch(n) for n in names):
            die(f"pack/live/PACK.json: {key} must be a list of check names")
        for n in names:
            if n in seen:
                die(f"pack/live/PACK.json: {n} listed twice")
            seen.add(n)
            if live_check(n) is None:
                die(f"pack/live/PACK.json: {key} names {n}, which is not in pack/live")
    return m


def live_check(name: str) -> Path | None:
    return next((LIVE / f"{name}{ext}" for ext in (".sh", ".py", "")
                 if name and (LIVE / f"{name}{ext}").is_file()), None)


# ---- state -----------------------------------------------------------------

def state_dir(repo: Path, override: str | None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    home = Path(os.environ.get("GETTING_CLOSE_HOME", "~/.getting-close")).expanduser()
    tag = hashlib.sha256(str(repo).encode()).hexdigest()[:8]
    return (home / f"{repo.name}-{tag}").resolve()


def need_state(st: Path) -> dict:
    mf = st / "manifest.json"
    if not mf.is_file():
        die(f"no state at {st}; run `gc init` first")
    return json.loads(mf.read_text(encoding="utf-8"))


def repo_python_args(st: Path) -> list[str]:
    """The manifest's `python` (gc init --python) as verify_ticket's --repo-python; [] when the manifest has none.
    verify_ticket passes it to every check as REPO_PYTHON, and clears an inherited one when it is absent."""
    py = need_state(st).get("python")
    return ["--repo-python", py] if py else []


def pytest_args_env(st: Path, env: dict | None = None) -> dict:
    """REPO_PYTEST_ARGS from the manifest only (gc init --pytest-args): set it when the manifest has `pytest_args`,
    drop an inherited one when not. verify_ticket hands its environment to every check, so E1 and U1 see it."""
    env = {k: v for k, v in (os.environ if env is None else env).items() if k != "REPO_PYTEST_ARGS"}
    pa = need_state(st).get("pytest_args")
    if pa:
        env["REPO_PYTEST_ARGS"] = pa
    return env


def check_env(st: Path, env: dict) -> dict:
    """REPO_PYTHON and REPO_PYTEST_ARGS from the manifest only: set each when the manifest names it, drop an
    inherited one when not."""
    env = {k: v for k, v in pytest_args_env(st, env).items() if k != "REPO_PYTHON"}
    py = need_state(st).get("python")
    if py:
        env["REPO_PYTHON"] = py
    return env


def latest(st: Path) -> str:
    p = st / "LATEST"
    if not p.is_file():
        die("no World yet; run `gc scan` first")
    return p.read_text(encoding="utf-8").strip()


ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")


def world_file(st: Path, world_id: str) -> Path:
    bare = world_id[len("scan_"):] if world_id.startswith("scan_") else world_id
    if not ID_RE.fullmatch(bare) or ".." in bare:
        die(f"illegal world id {world_id!r}")
    return st / "worlds" / f"scan_{bare}.json"


# KERNEL.md M2/M3: a land rejected by an every-ticket check is a strike and closes its ticket.
# After `gets_through_anyway` struck tickets on one task, gc mints no more for it and the signer
# decides what next. The number is the signer's to change (`gc policy --gets-through-anyway N`).
# A policy.json written before the rename still loads: `handoff_after` is read when the new key is absent.
GETS_THROUGH_DEFAULT = 2
# M5a/D1: a check that could not run exits this (sysexits EX_TEMPFAIL). KERNEL.md T16 (2026-10-19): what
# the gate could not bring to a verdict is let through. A 75 does not change the decision: the land proceeds if nothing
# struck, the row lists the check under `not_run` and carries the reason, and the ticket is not struck. (Before T16 the
# land was refused without a strike.) The one 75 still refused is no `sandbox-exec` on the host: cmd_land checks for it
# before apply, because without it nothing can be held read-only (K2) and no check at all can run.
NOT_RUN = 75


def policy(st: Path) -> dict:
    p = st / "policy.json"
    try:
        data = json.loads(p.read_text(encoding="utf-8")) if p.is_file() else {}
    except (OSError, json.JSONDecodeError) as e:
        die(f"policy.json unreadable: {e}")
    if not isinstance(data, dict):
        die("policy.json: must be a JSON object")
    n = data.get("gets_through_anyway", data.get("handoff_after", GETS_THROUGH_DEFAULT))
    if isinstance(n, bool) or not isinstance(n, int) or n < 1:
        die("policy.json: gets_through_anyway must be an integer >= 1")
    return {"gets_through_anyway": n}


def trusted_rows(lpath: Path, doing: str) -> list[dict]:
    """Ledger rows to decide from. A broken chain is refused, not read: an edited row could hide a strike."""
    problems = ledger.check(lpath)
    if problems:
        die(f"ledger chain broken; refusing to {doing}: " + "; ".join(problems))
    return ledger.read(lpath)


def struck(rows: list[dict]) -> dict[str, int]:
    """ticket_id -> ledger seq of the land that struck it."""
    return {str(r.get("ticket_id")): r.get("seq") for r in rows if r.get("strike")}


def task_struck(st: Path, task: str, rows: list[dict]) -> list[str]:
    """Struck tickets of one task, oldest first. A ticket without a task field is its own task."""
    hit = struck(rows)
    out = []
    for f in (st / "tickets").glob("*.json"):
        t = json.loads(f.read_text(encoding="utf-8"))
        tid = str(t.get("ticket_id"))
        if t.get("task", tid) == task and tid in hit:
            out.append(tid)
    return sorted(out, key=lambda tid: hit[tid])


ast_only = 0x400  # ast.PyCF_ONLY_AST: parse, never build code objects


def syntax_errors(payload: Path, write_set: list[str]) -> list[str]:
    """Staged python that does not parse. The writer cannot run code, so this is rejected before
    apply and before any check runs: no strike, and nothing about S1 is revealed (M3)."""
    out = []
    for rel in write_set:
        src = safepath.walk(payload, rel, allow_multilink=True)
        data = src.read_bytes()
        if not is_python(rel, data[:128]):
            continue
        try:
            compile(data, rel, "exec", dont_inherit=True, flags=ast_only)
        except (SyntaxError, ValueError) as e:  # ValueError: null bytes in source, before Python 3.12
            line = getattr(e, "lineno", None)
            out.append(f"syntax error {rel}{f':{line}' if line else ''}: {getattr(e, 'msg', e)} (no strike; fix and re-stage)")
    return out


def new_world_id() -> str:
    # R6 default: opaque, unique per launch.
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
    return f"scan_{ts}_{secrets.token_hex(2)}"


# ---- subcommands -------------------------------------------------------------

def cmd_init(a, repo: Path, st: Path) -> int:
    mf = st / "manifest.json"
    if mf.exists():
        die(f"already initialised: {mf}")
    if repo.resolve() == HERE or HERE in repo.resolve().parents:
        die("refusing to guard the getting-close tree itself")
    roots = [{"root_id": a.root_id, "role": "primary", "path": str(repo), "exclude": a.exclude}]
    for extra in a.dep:
        rid, _, path = extra.partition("=")
        if not rid or not path:
            die(f"--dep wants ROOT_ID=PATH, got {extra!r}")
        roots.append({"root_id": rid, "role": "dep", "path": str(Path(path).expanduser().resolve()), "exclude": []})
    manifest = {"kind": "scan_manifest", "version": 1, "manifest_id": repo.name, "repo": str(repo), "roots": roots}
    if a.python:
        # Kept as given, not resolved: a venv's bin/python is a symlink to the base interpreter, and resolving it
        # would drop the venv (its site-packages come from the path it was started by).
        py = Path(a.python)
        if not py.is_absolute():
            die(f"--python wants an absolute path, got {a.python!r}")
        if not py.is_file() or not os.access(py, os.X_OK):
            die(f"--python is not an executable file: {a.python}")
        manifest["python"] = str(py)
    if a.pytest_args is not None:
        # Kept as given (one string of shell words); E1 and U1 split it with shlex and add it to every pytest run.
        try:
            words = shlex.split(a.pytest_args)
        except ValueError as e:
            die(f"--pytest-args is not shell words: {e}")
        if not words:
            die("--pytest-args is empty")
        manifest["pytest_args"] = a.pytest_args
    for sub in ("manifests", "worlds", "tickets"):
        (st / sub).mkdir(parents=True, exist_ok=True)
    mf.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    print(f"gc: initialised {repo}\ngc: state {st}")
    return 0


def cmd_scan(a, repo: Path, st: Path) -> int:
    manifest = need_state(st)
    wid = new_world_id()
    manifest = {**manifest, "world_id": wid}
    used = st / "manifests" / f"{wid}.json"
    used.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    out = world_file(st, wid)
    rc = run_tool("emit_world.py", str(used), "--out", str(out))
    if rc != 0:
        return rc
    # S1's before-facts: frozen beside the World and bound to it. A World without one cannot land
    # under a pack that runs S1, so it never becomes LATEST.
    pack = pack_manifest()
    if pack and "S1" in pack["world"] + pack["every_ticket"] + pack["named"]:
        rc = subprocess.run([sys.executable, str(HERE / "scanner" / "substance.py"), "before", str(used),
                             "--world", str(out), "--out", str(out.with_suffix(".substance.json"))],
                            stdout=subprocess.DEVNULL).returncode
        if rc != 0:
            die(f"substance overlay failed for {wid}; World left unpublished", rc)
    (st / "LATEST").write_text(wid + "\n", encoding="utf-8")
    print(wid)
    return 0


def cmd_worlds(a, repo: Path, st: Path) -> int:
    need_state(st)
    cur = (st / "LATEST").read_text().strip() if (st / "LATEST").is_file() else None
    for f in sorted((st / "worlds").glob("scan_*.json")):
        if f.name.endswith(".substance.json"):
            continue
        data = json.loads(f.read_text(encoding="utf-8"))
        s = data.get("stats", {})
        mark = "*" if data.get("world_id") == cur else " "
        frozen = "frozen" if not os.access(f, os.W_OK) else "WRITABLE"
        print(f"{mark} {data.get('world_id')}  {frozen}  units={s.get('units')} defs={s.get('defs')} unresolved={s.get('unresolved')}")
    return 0


def cmd_read(a, repo: Path, st: Path) -> int:
    need_state(st)
    wid = a.world or latest(st)
    if not a.keys:
        return run_tool("read_world.py", str(world_file(st, wid)))
    return run_tool("read_world.py", "--worlds-dir", str(st / "worlds"), wid, *a.keys)


EXPECT_FORMS = ("result", "raises", "true")


def claims_path(st: Path, tid: str) -> Path:
    return st / "claims" / f"{tid}.json"


def _claim_names_module(name: str, write_set: list[str]) -> bool:
    """`pkg.mod.Class.func` names a module when some dotted prefix is a .py (or package) in the write_set,
    whatever directories lead to it (src/pkg/mod.py is pkg.mod)."""
    parts = name.split(".")
    for k in range(len(parts) - 1, 0, -1):
        mod = "/".join(parts[:k])
        for rel in write_set:
            if rel in (f"{mod}.py", f"{mod}/__init__.py") or rel.endswith((f"/{mod}.py", f"/{mod}/__init__.py")):
                return True
    return False


def claim_problems(claims: object, write_set: list[str]) -> list[str]:
    """Why a claims file cannot be minted. A claim is a small sealed test: name, optional setup, call, expect."""
    if not isinstance(claims, list) or not claims:
        return ["must be a non-empty JSON list of claims"]
    out: list[str] = []
    for i, c in enumerate(claims, 1):
        if not isinstance(c, dict):
            out.append(f"claim {i}: not an object"); continue
        name, call, expect, setup = c.get("name"), c.get("call"), c.get("expect"), c.get("setup", [])
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z_][\w]*(\.[A-Za-z_][\w]*)+", name):
            out.append(f"claim {i}: name must be a dotted path like pkg.mod.func"); continue
        if not _claim_names_module(name, write_set):
            out.append(f"claim {i}: {name} names no module in the write_set")
        if not isinstance(call, str) or not call.strip():
            out.append(f"claim {i} ({name}): call must be a non-empty Python expression")
        if not isinstance(setup, list) or not all(isinstance(s, str) for s in setup):
            out.append(f"claim {i} ({name}): setup must be a list of Python statements")
        if not isinstance(expect, dict) or len(expect) != 1 or next(iter(expect)) not in EXPECT_FORMS:
            out.append(f"claim {i} ({name}): expect must be one of {{result: literal}}, {{raises: Name}}, {{true: expr}}")
        elif "raises" in expect and not (isinstance(expect["raises"], str) and expect["raises"].isidentifier()):
            out.append(f"claim {i} ({name}): raises must name an exception class")
        elif "true" in expect and not (isinstance(expect["true"], str) and expect["true"].strip()):
            out.append(f"claim {i} ({name}): true must be a Python expression")
        if "<FILL:" in json.dumps(c):
            out.append(f"claim {i} ({name}): still holds a <FILL: ...> placeholder from claims_draft; the signer fills it")
        extra = set(c) - {"name", "setup", "call", "expect"}
        if extra:
            out.append(f"claim {i} ({name}): unknown keys {sorted(extra)}")
    return out


def cmd_ticket(a, repo: Path, st: Path) -> int:
    need_state(st)
    wid = a.world or latest(st)
    if not world_file(st, wid).is_file():
        die(f"no World {wid}")
    # The check apply runs at land, run now: a ticket on a World that cannot load could never land.
    world_v1.load_world_v1(world_file(st, wid), expect_world_id=wid, require_frozen=True, tool="gc")
    tid = a.id or f"T-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S')}-{secrets.token_hex(2)}"
    if not ID_RE.fullmatch(tid) or ".." in tid:
        die(f"illegal ticket id {tid!r}")
    out = st / "tickets" / f"{tid}.json"
    if out.exists():
        die(f"ticket exists: {out}")
    # A signer typo must not mint a dangerous write_set (a red-team hole).
    for rel in a.write:
        if safepath.bad_chars(rel):
            die(f"control or separator character in path {rel!r}")
        if unicodedata.normalize("NFC", rel) != rel:
            die(f"path is not NFC-normalized: {rel!r}")
    if len({safepath.fold(r) for r in a.write}) != len(a.write):
        die("write_set has paths that collide case-insensitively (or duplicates)")
    task = a.task or tid
    if not ID_RE.fullmatch(task) or ".." in task:
        die(f"illegal task name {task!r}")
    n = policy(st)["gets_through_anyway"]
    done = task_struck(st, task, trusted_rows(st / "ledger.jsonl", "mint a ticket"))
    if len(done) >= n:
        die(f"task {task} is closed to new tickets: {len(done)} struck ticket(s) ({', '.join(done)}), "
            f"gets_through_anyway={n}. The signer decides what next, or changes the number with "
            "`gc policy --gets-through-anyway N` (M3).")
    ticket = {"ticket_id": tid, "world_id": wid, "write_set": a.write, "verify": a.verify, "task": task}
    # T5 (2026-10-15): claims are stated at mint by the signer; a ticket without claims is not minted. The claims
    # file is sealed from the writer (pre_tool denies the state dir) and bound to the ticket by sha256.
    if not a.claims:
        die("a ticket needs claims (--claims FILE): what the code in its write_set is required to do (T5)")
    claims_src = Path(a.claims)
    try:
        claims = json.loads(claims_src.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        die(f"cannot read claims {a.claims}: {e}")
    for problem in claim_problems(claims, a.write):
        die(f"claims {a.claims}: {problem}")
    claims_bytes = (json.dumps(claims, indent=2) + "\n").encode("utf-8")
    ticket["claims_sha256"] = hashlib.sha256(claims_bytes).hexdigest()
    pack = pack_manifest()
    if pack:
        # Bound to the pack it was minted under; a land under any other pack version is refused.
        ticket |= {"pack_version": pack["pack_version"], "invariant_id": a.verify}
        if live_check(a.verify) is None:
            die(f"verify {a.verify!r} is not in the live pack")
    if a.overlay:
        try:
            overlay = json.loads(Path(a.overlay).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as e:
            die(f"cannot read overlay {a.overlay}: {e}")
        if not isinstance(overlay, dict):
            die("overlay must be a JSON object")
        ticket["overlay"] = overlay
    budget = {k: v for k, v in (("max_files", a.max_files), ("max_bytes", a.max_bytes)) if v is not None}
    if budget:
        ticket["budget"] = budget
    (st / "claims").mkdir(parents=True, exist_ok=True)
    claims_path(st, tid).write_bytes(claims_bytes)
    out.write_text(json.dumps(ticket, indent=2) + "\n", encoding="utf-8")
    print(out)
    return 0


def _ticket_path(st: Path, t: str, writer: bool = False) -> str:
    """Signer may name any ticket file. Writer may name only an id under the signer's tickets/:
    a writer can write payload files, so a path argument would let it forge its own ticket."""
    p = Path(t)
    if writer or not p.is_file():
        tid = t[: -len(".json")] if t.endswith(".json") else t
        if not ID_RE.fullmatch(tid) or ".." in tid:
            die(f"illegal ticket id {t!r}")
        p = st / "tickets" / f"{tid}.json"
    if not p.is_file():
        die(f"no ticket {t}")
    return str(p)


def payload_dir(st: Path, ticket_path: str) -> Path:
    return st / "payload" / Path(ticket_path).stem


def cmd_tickets(a, repo: Path, st: Path) -> int:
    need_state(st)
    hit = struck(trusted_rows(st / "ledger.jsonl", "list tickets"))
    for f in sorted((st / "tickets").glob("*.json")):
        t = json.loads(f.read_text(encoding="utf-8"))
        tid = str(t.get("ticket_id"))
        status = f"  STRUCK at ledger seq {hit[tid]} (closed; ask the signer)" if tid in hit else ""
        print(f"{tid}  task={t.get('task', tid)}  world={t.get('world_id')}  verify={t.get('verify')}{status}")
        print(f"    stage into: {payload_dir(st, str(f))}/")
        for rel in t.get("write_set", []):
            print(f"    write: {rel}")
    return 0


def cmd_apply(a, repo: Path, st: Path) -> int:
    need_state(st)
    tp = _ticket_path(st, a.ticket, a.writer)
    pd = getattr(a, "payload_dir", None) or str(payload_dir(st, tp))
    return run_tool("apply_ticket.py", "--ticket", tp, "--root", str(repo),
                    "--payload-dir", pd, "--worlds-dir", str(st / "worlds"))


LAND_EXIT = {"proceed": 0, "reject": 1, "reroute": 3}


class Saved:
    """Pre-apply state of a land, for rollback on reject. Preflight already refused links, so
    each destination is absent or a single-link regular file."""

    def __init__(self, repo: Path, write_set: list[str]):
        self.repo = repo
        self.files: list[tuple[Path, bytes | None]] = []
        self.rels: list[str] = list(write_set)
        self.created_dirs: list[Path] = []
        for rel in write_set:
            dest = safepath.walk(repo, rel)
            self.files.append((dest, safepath.read(dest) if os.path.lexists(dest) else None))
            for d in safepath.missing_dirs(repo, rel):
                if d not in self.created_dirs:
                    self.created_dirs.append(d)

    def rollback(self) -> None:
        for dest, data in self.files:
            if data is None:
                if os.path.lexists(dest):
                    os.unlink(dest)
            else:
                safepath.write(dest, data)
        # Only directories this land created, deepest first; never one that existed before.
        for d in sorted(self.created_dirs, key=lambda x: len(x.parts), reverse=True):
            if d.is_dir() and not d.is_symlink() and not any(d.iterdir()):
                try:
                    d.rmdir()
                except OSError as e:
                    # Written into after the check: leave it. A stray dir must not cost the land its ledger row.
                    print(f"gc: rollback left directory {d}: {e}", file=sys.stderr)

    def before_root(self) -> Path:
        """M5: a temp tree of the pre-apply write_set at the same relpaths, for checks as BEFORE_ROOT.
        A file absent there is new in this ticket. The caller removes it after the land."""
        root = Path(tempfile.mkdtemp(prefix="gc-before-"))
        for rel, (_, data) in zip(self.rels, self.files):
            if data is not None:
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                (root / rel).write_bytes(data)
        return root


def cmd_land(a, repo: Path, st: Path) -> int:
    """Governor pre-check -> apply -> verify -> Governor verdict -> rollback on reject -> ledger row.
    Exit 0 proceed, 1 reject, 3 reroute. Every attempt is ledgered. T16: a check that exits 75 (not run) or says
    `<name> unjudged:` is recorded in the row (`not_run`, `unjudged`, a reason) and does not change the decision."""
    need_state(st)
    tp = Path(_ticket_path(st, a.ticket, a.writer))
    ticket = json.loads(tp.read_text(encoding="utf-8"))
    tid, wid = str(ticket.get("ticket_id")), str(ticket.get("world_id"))
    if tp.stem != tid:
        die(f"ticket file {tp.name} does not match ticket_id {tid}")
    # T5: the claims the signer minted must be the claims that are there. A rewrite is refused, no row.
    cp = claims_path(st, tid)
    if not cp.is_file():
        die(f"ticket {tid} has no claims file at {cp}; mint a ticket with --claims (T5)")
    if ledger.sha256_file(cp) != ticket.get("claims_sha256"):
        die(f"claims file {cp} does not match the ticket's claims_sha256; refusing to land")
    payload = payload_dir(st, str(tp))
    wf = world_file(st, wid)
    lpath = st / "ledger.jsonl"
    with ledger.locked(st):
        # A broken chain cannot take a row, so nothing may land: check before touching the repo.
        problems = ledger.check(lpath)
        if problems:
            die("ledger chain broken; refusing to land: " + "; ".join(problems))
        rows = ledger.read(lpath)
        facts = governor.preflight(ticket, repo=repo, payload=payload, world_file=wf,
                                   latest_world=latest(st), merged_rows=ledger.merged(rows))
        decision, reasons = governor.decide(facts, None)
        pack = pack_manifest()
        if pack and decision == governor.PROCEED and ticket.get("pack_version") != pack["pack_version"]:
            decision, reasons = governor.REJECT, [
                f"ticket pack_version {ticket.get('pack_version')!r} != live pack {pack['pack_version']}"]
        # M2: one strike per ticket. A struck ticket never reaches apply again.
        if tid in struck(rows):
            decision, reasons = governor.REJECT, [
                f"ticket struck at ledger seq {struck(rows)[tid]}: closed (M2); the signer mints a new ticket"]
        elif decision == governor.PROCEED:
            bad = syntax_errors(payload, facts.write_set)
            if bad:
                decision, reasons = governor.REJECT, bad
        # The one "not run" T16 does not let through: without sandbox-exec no verify can be held read-only (K2),
        # so nothing would be judged at all. Refused before apply, no strike (verify_ticket.py would exit 75).
        if decision == governor.PROCEED and not shutil.which("sandbox-exec"):
            decision, reasons = governor.REJECT, [
                "no sandbox-exec on this host: nothing can be held read-only (K2); land refused, no strike"]
        verify_exit = patch = None
        checks: list[dict] = []
        evidence: dict[str, list[dict]] = {}
        strike = False
        not_run: list[str] = []
        unjudged: list[str] = []
        saved: Saved | None = None
        before: Path | None = None
        applied = False
        try:
            if decision == governor.PROCEED:
                saved = Saved(repo, facts.write_set)
                before = saved.before_root()
                common = ["--ticket", str(tp), "--worlds-dir", str(st / "worlds")]
                judged = [*common, "--scoped-root", str(repo), "--before-root", str(before), "--verify-dir", str(LIVE),
                          *repo_python_args(st)]
                applied = True  # set before the call: an apply cut off midway may have written part of the set
                if run_tool("apply_ticket.py", *common, "--root", str(repo), "--payload-dir", str(payload)) != 0:
                    saved.rollback()
                    decision, reasons = governor.REJECT, ["apply_ticket refused"]
                else:
                    verify_exit = run_tool("verify_ticket.py", *judged, env=pytest_args_env(st))
                    # T16: a verify exit 75 is a proceed with its reason recorded (governor.decide), not a reject.
                    decision, reasons = governor.decide(facts, verify_exit)
                    # Pack v2+: the ticket's own verify is not enough; every World and every-ticket check
                    # runs on the applied patch, all of them, so the row records each exit.
                    vname = str(ticket.get("verify", ""))
                    if verify_exit == NOT_RUN:
                        not_run.append(vname)
                    for name in ([n for n in pack["world"] + pack["every_ticket"] if n != vname]
                                 if pack and decision == governor.PROCEED else []):
                        rc, said, ev, unj = run_check(*judged, "--check", name, env=pytest_args_env(st))
                        checks.append({"name": name, "sha256": ledger.sha256_file(live_check(name)), "exit": rc,
                                       "said": said})
                        if ev:
                            evidence[name] = ev
                        unjudged += unj
                        if rc == NOT_RUN:
                            # T16: not judged is not a verdict. Recorded in the row (not_run and this reason), let through.
                            not_run.append(name)
                            reasons.append(f"{name} not run (exit {NOT_RUN}): no strike, not judged (T16)")
                        elif rc != 0 and decision == governor.PROCEED:
                            decision, reasons = governor.REJECT, [r for r in reasons if "not judged" in r] + [f"{name} exit {rc}"]
                        elif rc != 0:
                            reasons.append(f"{name} exit {rc}")
                    every = set(pack["every_ticket"]) if pack else set()
                    strike = any(c["exit"] not in (0, NOT_RUN) and c["name"] in every for c in checks) or (
                        vname in every and verify_exit not in (None, 0, NOT_RUN))
                    if decision == governor.PROCEED:
                        patch = ledger.tree_hash([(rel, repo / rel) for rel in facts.write_set])
                    else:
                        saved.rollback()
                        reasons.append("rolled back")
            vname = str(ticket.get("verify", ""))
            vfile = live_check(vname)
            row_data = {
                # KERNEL.md L1: draft ledger. Draft rows do not count.
                "status": "draft",
                "ticket_id": tid, "ticket_sha256": ledger.sha256_file(tp),
                "world_id": wid, "world_sha256": ledger.sha256_file(wf) if wf.is_file() else None,
                "pack_sha256": ledger.pack_hash(LIVE), "kernel_sha256": ledger.kernel_hash(),
                "verify": vname, "verify_sha256": ledger.sha256_file(vfile) if vfile else None,
                "verify_exit": verify_exit, "write_set": facts.write_set, "patch_sha256": patch,
                "claims_sha256": ticket.get("claims_sha256"),
                "decision": decision, "reasons": reasons,
            }
            if pack:
                row_data |= {"pack_version": pack["pack_version"], "checks": checks}
            if not_run:
                row_data |= {"not_run": not_run}
            if unjudged:  # T16: what a check said it could not judge (`<name> unjudged: ...` lines), every one
                row_data |= {"unjudged": unjudged}
            if strike:
                row_data |= {"strike": True, "task": str(ticket.get("task", tid))}
                reasons.append("strike: ticket closed (M2)")
            row = ledger.append(lpath, row_data)
            if evidence:  # sealed from the writer (pre_tool denies the state dir); one file per land, by seq
                (st / "evidence").mkdir(parents=True, exist_ok=True)
                (st / "evidence" / f"{tid}.{row['seq']}.json").write_text(
                    json.dumps({"ticket_id": tid, "seq": row["seq"], "decision": decision, "checks": evidence},
                               indent=2) + "\n", encoding="utf-8")
        except BaseException:
            # No row, no merge (K3): from apply until the row is written, any failure undoes the patch.
            # Rollback restores the saved bytes, so one after a reject's own rollback is harmless.
            if applied and saved is not None:
                saved.rollback()
            raise
        finally:
            if before is not None:
                shutil.rmtree(before, ignore_errors=True)
    print(json.dumps({"decision": decision, "ticket_id": tid, "reasons": reasons, "ledger_seq": row["seq"]}))
    return LAND_EXIT[decision]


def cmd_policy(a, repo: Path, st: Path) -> int:
    """Show or set the signer's numbers. gets_through_anyway (M3): struck tickets per task before gc stops
    minting for it. Read at mint time, so a change applies to the next `gc ticket`. Writes only the new key."""
    need_state(st)
    cur = policy(st)
    if a.gets_through_anyway is not None:
        if a.gets_through_anyway < 1:
            die("--gets-through-anyway must be >= 1")
        cur["gets_through_anyway"] = a.gets_through_anyway
        (st / "policy.json").write_text(json.dumps(cur, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(cur | {"default_gets_through_anyway": GETS_THROUGH_DEFAULT}))
    return 0


def cmd_ledger(a, repo: Path, st: Path) -> int:
    need_state(st)
    lpath = st / "ledger.jsonl"
    problems = ledger.check(lpath)
    if a.check:
        for p in problems:
            print(f"gc: ledger {p}", file=sys.stderr)
        print("gc: ledger " + ("BROKEN" if problems else f"OK rows={len(ledger.read(lpath))}"))
        return 1 if problems else 0
    try:
        rows = ledger.read(lpath)
    except ValueError:
        rows = []  # a line that is not JSON: the problem list below names it
    for r in rows:
        if not isinstance(r, dict):
            continue
        print(f"{r.get('seq')!s:>4} {r.get('ts')} {r.get('status')!s:6} {r.get('decision')!s:8} {r.get('ticket_id')}"
              f"  verify={r.get('verify')}:{r.get('verify_exit')}  {'; '.join(r.get('reasons') or [])}")
    if problems:
        print("gc: ledger BROKEN: " + "; ".join(problems), file=sys.stderr)
        return 1
    return 0


def cmd_verify(a, repo: Path, st: Path) -> int:
    need_state(st)
    dirs = ["--verify-dir", str(LIVE)]
    if getattr(a, "allow_proposals", False):
        dirs += ["--verify-dir", str(PROPOSALS)]
    return run_tool("verify_ticket.py", "--ticket", _ticket_path(st, a.ticket, a.writer), "--worlds-dir", str(st / "worlds"),
                    "--scoped-root", str(repo), *dirs, *repo_python_args(st), env=pytest_args_env(st))


def cmd_check(a, repo: Path, st: Path) -> int:
    """Run every live verify against the newest World. Exit 0 only if all pass."""
    need_state(st)
    wf = world_file(st, a.world or latest(st))
    env = check_env(st, {**os.environ, "WORLD_FILE": str(wf), "SCOPED_ROOT": str(repo)})
    failed = []
    pack = pack_manifest()
    # Pack v2+: only World checks; ticket checks need a ticket and run at land.
    checks = [live_check(n) for n in pack["world"]] if pack else sorted(LIVE.iterdir())
    for v in checks:
        if v is None or v.suffix not in (".sh", ".py") or not v.is_file():
            continue
        cmd = [sys.executable, str(v)] if v.suffix == ".py" else ["sh", str(v)]
        # Same boundary as verify_ticket: a check reads; it never writes kernel, repo or state.
        deny = [HERE, repo, st] + (verify_ticket.interpreter_roots(env["REPO_PYTHON"]) if "REPO_PYTHON" in env else [])
        if verify_ticket.run_sandboxed(cmd, env, deny) != 0:
            failed.append(v.name)
    if failed:
        print(f"gc: check FAIL {' '.join(failed)}", file=sys.stderr)
        return 1
    print("gc: check PASS")
    return 0


ADAPTER = HERE / "adapters" / "claude_code"
WRITER_TOOLS = "Read,Grep,Glob"


# T17 (2026-10-19): the writer session launches through the signer's normal `claude`, proxy and all; the
# earlier "go direct" ruling was purged with the pre-rebuild rulings. The tool set is still what
# --tools, --strict-mcp-config and the PreToolUse hook declare.


def writer_launch(repo: Path, st: Path) -> list[str]:
    return ["claude", "--restricted", "--settings", str(st / "claude-writer.json"),
            "--strict-mcp-config", "--mcp-config", str(st / "mcp.json"),
            "--tools", WRITER_TOOLS, "--permission-mode", "dontAsk"]


def cmd_writer_setup(a, repo: Path, st: Path) -> int:
    """Write the Claude Code writer session config for this repo and print the launch command.
    The writer session is the cutover path (KERNEL.md C1).

    The session has no raw write tool at all:
      --tools Read,Grep,Glob   built-ins offered; no Bash/Edit/Write/Agent/Skill/Web. Context-level,
                               so bypassPermissions cannot bring them back.
      --strict-mcp-config      only the `gc` MCP server (adapters/claude_code/gc_mcp.py): stage,
                               stage_edit, land, verify, check, read, worlds, tickets, ledger.
      --restricted             ignores user/project/local settings files (only --settings and
                               managed apply), refuses bypassPermissions, confines file tools.
      permissions (dontAsk)    allow Read/Grep/Glob/mcp__gc; nothing prompts, so nothing else runs.
      PreToolUse hook          same allowlist again (belt; hooks fail open, nothing depends on it).
      Stop hook                cannot end until `gc-writer check` exits 0 (R9).
    """
    need_state(st)
    (st / "payload").mkdir(exist_ok=True)
    wrapper = st / "gc-writer"
    wrapper.write_text("#!/bin/sh\n# getting-close writer entry. Repo and state are fixed here.\n"
                       f"exec {shlex.quote(sys.executable)} {shlex.quote(str(BIN / 'gc'))} "
                       f"--writer-state {shlex.quote(str(st))} \"$@\"\n", encoding="utf-8")
    wrapper.chmod(0o755)
    mcp = {"mcpServers": {"gc": {"type": "stdio", "command": sys.executable,
                                 "args": [str(ADAPTER / "gc_mcp.py"), str(st)]}}}
    (st / "mcp.json").write_text(json.dumps(mcp, indent=2) + "\n", encoding="utf-8")
    py, sq = shlex.quote(sys.executable), shlex.quote(str(st))
    settings = {
        "permissions": {"defaultMode": "dontAsk", "allow": ["Read", "Grep", "Glob", "mcp__gc"]},
        "enableAllProjectMcpServers": False,
        "hooks": {
            "PreToolUse": [{"matcher": "*", "hooks": [
                {"type": "command", "command": f"{py} {shlex.quote(str(ADAPTER / 'pre_tool.py'))} {sq}", "timeout": 30}]}],
            "Stop": [{"hooks": [
                {"type": "command", "command": f"{py} {shlex.quote(str(ADAPTER / 'stop_gate.py'))} {sq}", "timeout": 180}]}],
        },
    }
    (st / "claude-writer.json").write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    print(f"gc: writer session config written to {st}")
    print("gc: launch from your shell:")
    print(f"  cd {shlex.quote(str(repo))} && " + " ".join(shlex.quote(x) for x in writer_launch(repo, st)))
    return 0


def cmd_glossary(a, repo: Path, st: Path) -> int:
    return run_tool("glossary.py", *a.args)


def cmd_selftest(a, repo: Path, st: Path) -> int:
    rc = subprocess.run(["sh", str(HERE / "plants" / "run_all.sh")], cwd=HERE).returncode
    print("gc: selftest " + ("PASS" if rc == 0 else "FAIL"))
    return 0 if rc == 0 else 1


# ---- main ------------------------------------------------------------------

def build_parser(writer: bool) -> argparse.ArgumentParser:
    """Signer parser has every subcommand. Writer parser has only the KERNEL.md cutover set
    (read_world, apply_ticket, verify_ticket) plus read-only listings; repo and state are
    fixed by the wrapper, so no --repo/--state/--payload-dir/--allow-proposals exist there."""
    p = argparse.ArgumentParser(prog="gc-writer" if writer else "gc", allow_abbrev=False,
                                description="getting-close: scan, freeze, and gate writes to a repo.")
    if not writer:
        p.add_argument("--repo", default=".", help="target repo (default: cwd)")
        p.add_argument("--state", default=None, help="state dir override (default: $GETTING_CLOSE_HOME/<repo>-<hash>)")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name: str, help: str, fn):
        s = sub.add_parser(name, help=help, allow_abbrev=False)
        s.set_defaults(fn=fn)
        return s

    if not writer:
        s = add("init", "register a repo to guard", cmd_init)
        s.add_argument("--root-id", default="app")
        s.add_argument("--exclude", action="append", default=[], help="path under the repo to skip, or a bare name to skip at any depth (repeatable)")
        s.add_argument("--dep", action="append", default=[], metavar="ROOT_ID=PATH", help="extra read-only root")
        s.add_argument("--python", default=None, metavar="PATH",
                       help="the repo's own interpreter (absolute); E1, C1 and U1 run the repo's code under it")
        s.add_argument("--pytest-args", default=None, metavar="ARGS",
                       help="the repo's own pytest settings, one string of shell words, e.g. "
                       "--pytest-args=\"-o python_files=tests_*.py tests\"; E1 and U1 add them to every pytest run "
                       "(as REPO_PYTEST_ARGS). Use the = form when ARGS is one word starting with -")
        add("scan", "emit a new frozen World", cmd_scan)

    add("worlds", "list Worlds (* = latest)", cmd_worlds)
    s = add("read", "stats, or keys, from a World", cmd_read)
    s.add_argument("--world", default=None)
    s.add_argument("keys", nargs="*")
    add("tickets", "list tickets and where to stage each one's files", cmd_tickets)

    if not writer:
        s = add("ticket", "create a ticket bound to the latest World", cmd_ticket)
        s.add_argument("--write", action="append", required=True, help="repo-relative path (repeatable)")
        s.add_argument("--verify", default="W1")
        s.add_argument("--world", default=None)
        s.add_argument("--id", default=None)
        s.add_argument("--max-files", type=int, default=None)
        s.add_argument("--max-bytes", type=int, default=None)
        s.add_argument("--overlay", default=None, help="scanner overlay JSON, for R10-1/R10-2 tickets")
        s.add_argument("--task", default=None, help="task this ticket serves; struck tickets count per task (M3)")
        s.add_argument("--claims", default=None, help="JSON list of claims: what the write_set's code must do (T5)")
        s = add("policy", "show or set signer numbers (gets_through_anyway)", cmd_policy)
        s.add_argument("--gets-through-anyway", type=int, default=None,
                       help="struck tickets per task before gc mints no more for it (M3)")

    s = add("land", "governor + apply + verify + ledger; rolls back on reject (exit 0/1/3)", cmd_land)
    s.add_argument("--ticket", required=True, help="ticket id" if writer else "ticket path or id")
    s = add("ledger", "list ledger rows", cmd_ledger)
    s.add_argument("--check", action="store_true", help="verify the hash chain only")

    if not writer:
        # Raw apply skips the Governor and the ledger. Signer only; writers land.
        s = add("apply", "raw apply_ticket, no governor/ledger (signer only)", cmd_apply)
        s.add_argument("--ticket", required=True, help="ticket path or id")
        s.add_argument("--payload-dir", default=None, help="default: <state>/payload/<ticket_id>")

    s = add("verify", "run a ticket's verify (live pack only)", cmd_verify)
    s.add_argument("--ticket", required=True, help="ticket id" if writer else "ticket path or id")
    if not writer:
        s.add_argument("--allow-proposals", action="store_true", help="also search proposals/ (drafts)")

    s = add("check", "run every live verify against a World", cmd_check)
    s.add_argument("--world", default=None)

    if not writer:
        s = add("writer-setup", "write the Claude Code writer session config (no raw write tools)", cmd_writer_setup)
        add("selftest", "run the plants (plants/run_all.sh)", cmd_selftest)
        s = add("glossary", "canonical names: check | lookup NAME | add NAME (see bin/glossary.py)", cmd_glossary)
        s.add_argument("args", nargs=argparse.REMAINDER)
    return p


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    # Writer mode: only reachable through <state>/gc-writer, which passes this first.
    if argv[:1] == ["--writer-state"]:
        if len(argv) < 2:
            die("--writer-state needs a path")
        st = Path(argv[1]).resolve()
        a = build_parser(writer=True).parse_args(argv[2:])
        a.writer = True
        repo = Path(need_state(st)["repo"])
        return a.fn(a, repo, st)

    a = build_parser(writer=False).parse_args(argv)
    a.writer = False
    repo = Path(a.repo).expanduser().resolve()
    if a.cmd not in ("selftest", "glossary") and not repo.is_dir():
        die(f"repo is not a directory: {repo}")
    return a.fn(a, repo, state_dir(repo, a.state))


if __name__ == "__main__":
    raise SystemExit(main())
